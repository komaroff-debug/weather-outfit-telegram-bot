# Required: token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN

DATABASE_PATH=data/weather_bot.db
DEFAULT_NOTIFICATION_TIME=07:30
LOG_LEVEL=INFO

# Optional Telegram API proxy.
# Leave empty if api.telegram.org:443 is directly reachable.
# Examples:
# TELEGRAM_PROXY=http://127.0.0.1:8080
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=socks5://login:password@proxy.example.com:1080
TELEGRAM_PROXY=